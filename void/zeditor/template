# Template file for 'zed'

pkgname=zeditor
version=1.2.3
revision=1
short_desc="A high-performance, multiplayer code editor from the creators of Atom and Tree-sitter"
maintainer="Rain Xelelo <rXelelo@outlook.com>"
license="GPL-3.0-or-later, AGPL-3.0-or-later, Apache-2.0"
homepage="https://zed.dev"
distfiles="https://github.com/zed-industries/zed/archive/v${version}/zed-${version}.tar.gz"
checksum="c397c39495239a7a5a774bd91164a6e17d6a07f224c2f5038fcd776d25ed04d1"

build_style=cargo
build_helper=qemu

hostmakedepends="cargo cargo-about clang cmake gettext protobuf pkg-config"
makedepends="
 alsa-lib-devel
 libcurl-devel
 fontconfig-devel
 glib-devel
 libgit2-devel
 libxcb-devel
 libX11-devel
 libxkbcommon-devel
 sqlite-devel
 Vulkan-Headers
 Vulkan-ValidationLayers
 wayland-devel
 zlib-devel
 libzstd-devel"

depends="
 alsa-lib
 curl
 fontconfig
 glib
 libgit2
 libxcb
 libxkbcommon
 netcat
 nodejs>=18
 nodejs
 sqlite
 vulkan-loader
 Vulkan-Tools
 wayland
 zlib
 zstd"

opt_depends="
 clang:improved C/C++ language support
 eslint:improved Javascript language support
 pyright:improved Python language support
 rust-analyzer:improved Rust language support"

replaces="zed-editor>=0"

_binname=zeditor
_appid=dev.zed.Zed

pre_build() {
	export DO_STARTUP_NOTIFY="true"
	export APP_ICON="zed"
	export APP_NAME="Zed"
	export APP_CLI="${_binname}"
	export APP_ID="${_appid}"
	export APP_ARGS="%U"
	envsubst < "crates/zed/resources/zed.desktop.in" > "${_appid}.desktop"
	./script/generate-licenses
}

do_build() {
	CFLAGS+=" -ffat-lto-objects"
	CXXFLAGS+=" -ffat-lto-objects"
	RUSTFLAGS+=" --remap-path-prefix ${PWD}=/"
	export LIBGIT2_NO_VENDOR=1
	export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
	export ZSTD_SYS_USE_PKG_CONFIG=1
	export ZED_UPDATE_EXPLANATION="Updates are handled by xbps"
	export RELEASE_VERSION="${version}"
	export PROTOC=/usr/bin/protoc
	export PROTOC_INCLUDE=/usr/include
	cargo build --release --frozen --package zed --package cli
}

do_install() {
	vbin target/release/cli "zed"
	vinstall target/release/zed 755 usr/lib/zed zeditor
	vinstall "${_appid}.desktop" 644 usr/share/applications
	vinstall crates/zed/resources/app-icon.png 644 \
		usr/share/icons/hicolor/512x512/apps zed.png
}
