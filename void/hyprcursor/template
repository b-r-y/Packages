post_install() {
	vlicense LICENSE
}

hyprcursor-devel_package() {
	depends="hyprcursor-${version}_${revision}"
	short_desc+=" - development files"

	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/pkgconfig
	}
}
