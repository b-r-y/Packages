# Template file for 'hyprcursor'
pkgname=hyprcursor
version=0.1.13
revision=3
build_style=cmake
configure_args=" --no-warn-unused-cli -DCMAKE_BUILD_TYPE=Release"
hostmakedepends="cmake pkg-config"
makedepends="
	tomlplusplus-devel
	hyprlang-devel
	cairo-devel
	pango-devel
	harfbuzz-devel
	librsvg-devel
	libzip-devel
"
