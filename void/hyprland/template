# Template file for 'hyprland'
pkgname=hyprland
version=0.55.4
revision=3
build_style=cmake
configure_args="-DNO_SYSTEMD=ON -DUSE_NATIVE_EMBED=OFF -DCMAKE_BUILD_TYPE=Release -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON"
hostmakedepends="cmake pkg-config autoconf git cpio glslang jq make ninja lua55"
makedepends="
	hyprgraphics
	hyprcursor-devel
	hyprutils-devel
	aquamarine-devel
	hyprlang-devel
	hyprland-protocols
	hyprwayland-scanner
	tomlplusplus-devel
	abseil-cpp-devel
	hwids
	cairo-devel
	libdisplay-info-devel
	libdrm-devel
	libgbm-devel
	libglvnd-devel
	libinput-devel
	libliftoff-devel
	libseat-devel
	libxcb-devel
	libXcursor-devel
	libxkbcommon-devel
	pango-devel
	wayland-devel
	wayland-protocols
	xorg-server-xwayland
	udis86-devel
	re2-devel
	xcb-util-errors-devel
	xcb-util-renderutil-devel
	xcb-util-wm-devel
	xcb-util-image-devel
	xorg-server-xwayland
	muparser-devel
	hyprwire
	hyprland-guiutils
	glslang-devel
	SPIRV-Tools-devel
	lcms2-devel
	lua55-devel
"
depends="
	hyprlang
	hyprwayland-scanner
	lcms2
	hyprgraphics
	hyprutils
	hyprcursor
	cairo
	glslang
	libliftoff
	libxcb
	libXfixes
	polkit
	vulkan-loader
	Vulkan-ValidationLayers
	wayland
	wayland-protocols
	xcb-proto
	xcb-util
	xcb-util-keysyms
	xorg-server-xwayland
	re2
	muparser
"
short_desc="Dynamic tiling Wayland compositor that doesn't sacrifice on its looks"
maintainer="hesam-init <hesam.init@gmail.com>"
license="BSD-3-Clause"
homepage="https://hyprland.org/"
changelog="https://github.com/hyprwm/Hyprland/releases"
distfiles="https://github.com/hyprwm/Hyprland/releases/download/v${version}/source-v${version}.tar.gz"
checksum=10cdda47e6a42e603a646ffda89c9fca0628c3a8211e2fbbee02f6282effe30b


hostmakedepends+=" gcc"
makedepends+=" libgcc-devel fmt-devel"

if [ "$XBPS_TARGET_LIBC" = "glibc" ]; then
	makedepends+=" glaze"
fi

if [ "$XBPS_TARGET_LIBC" = "musl" ]; then
	configure_args+=" -DCMAKE_CXX_FLAGS=\"-lexecinfo\""
	makedepends+=" libexecinfo-devel"
	depends+=" libexecinfo"
fi

post_install() {
	vlicense LICENSE
    
    vinstall ${wrksrc}/build/hyprland.pc 644 usr/share/pkgconfig
    vinstall ${wrksrc}/build/hyprland.pc 644 usr/lib/pkgconfig
}

hyprland-devel_package() {
	short_desc="Dynamic tiling Wayland compositor - development files"
	depends="${sourcepkg}>=${version}_${revision} ${makedepends}"
	pkg_install() {
		vmove usr/include
		vmove usr/share/pkgconfig
    	make -C ${wrksrc} installheaders PREFIX=/usr DESTDIR=${DESTDIR}
	}
}
