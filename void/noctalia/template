# this template for 'noctalia'

pkgname=noctalia
version=5.0.0
revision=1
build_style=meson
#configure_args="-Dbuildtype=release"
 
short_desc="Noctalia desktop shell"
maintainer="Noctalia <team@enoctalia.dev>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia-shell"
 
hostmakedepends="meson ninja pkg-config git"
 
makedepends="
 wayland-devel
 wayland-protocols
 libepoxy-devel
 MesaLib-devel
 libglvnd-devel
 cairo-devel
 pango-devel
 fontconfig-devel
 freetype-devel
 harfbuzz-devel
 libxkbcommon-devel
 pipewire-devel
 libcurl-devel
 pam-devel
 libwebp-devel
 basu-devel
 libcurl-devel
 sdbus-c++-devel
 polkit-devel
"
 
depends="
 wayland
 pipewire
 pam
 libwebp
 basu
"
 
CXXFLAGS+=" -std=c++20"

do_fetch() {
        git clone https://github.com/noctalia-dev/noctalia-shell.git --branch v5 ${wrksrc}

        # Update revision
        cd ${wrksrc}
        SHA=$(git rev-parse --short HEAD)
        revision+=".r$SHA"
}
 
post_install() {
        if [ -f LICENSE ]; then
                vlicense LICENSE
        fi
 
        if [ ! -x "${DESTDIR}/usr/bin/noctalia" ]; then
                msg_error "Expected binary /usr/bin/noctalia not found.\n"
        fi
}