# this template for 'noctalia'
MAIN=$(curl -S "https://api.github.com/repos/noctalia-dev/noctalia-greeter/git/refs/heads/main")
SHA=$(echo $MAIN | jq -r '.object.sha[:7]')

COMMIT=$(curl -S "https://api.github.com/repos/noctalia-dev/noctalia-greeter/commits/$SHA")
DATE=$(echo $COMMIT | jq -r '.commit.committer.date | split("T")[0] | gsub("-"; ".")')

pkgname=noctalia-greeter
version=0.0.1.r${DATE}.${SHA}
revision=0
build_style=meson
#configure_args="-Dbuildtype=release"
short_desc="Noctalia themed greeter for greetd"
maintainer="Noctalia <team@enoctalia.dev>"
license="MIT"
homepage="https://github.com/noctalia-dev/noctalia-greeter"

hostmakedepends="meson ninja pkg-config git"

makedepends="
 wayland-devel
 wlroots0.20-devel
 wayland-protocols
 libepoxy-devel
 MesaLib-devel
 libglvnd-devel
 cairo-devel
 pango-devel
 fontconfig-devel
 freetype-devel
 libxkbcommon-devel
 librsvg-devel
 libwebp-devel
"

depends="
 greetd
 cage
 wlr-randr
 dbus
 polkit
"

CXXFLAGS+=" -std=c++20"

do_fetch() {
        git clone https://github.com/noctalia-dev/noctalia-greeter.git --branch main ${wrksrc}
}

post_install() {
        if [ -f LICENSE ]; then
                vlicense LICENSE
        fi

        if [ ! -x "${DESTDIR}/usr/bin/noctalia-greeter-session" ]; then
                msg_error "Expected binary /usr/bin/noctalia-greeter-session not found.\n"
        fi
}
