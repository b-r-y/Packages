# Template file for 'lua55-penlight'
pkgname=lua55-penlight
version=1.15.0
revision=1
hostmakedepends="lua55 lua53 lua52 lua51 zip luarocks-lua55"
makedepends="lua55-devel lua53-devel lua52-devel lua51-devel lua55-luafilesystem"
depends="lua55 lua55-luafilesystem"
short_desc="Lua libraries focusing on input data handling"
maintainer="Luciogi <githubvoidlinux.supremacy429@passinbox.com>"
license="MIT"
homepage="https://github.com/lunarmodules/Penlight"
distfiles="https://github.com/lunarmodules/Penlight/archive/refs/tags/${version}.tar.gz"
checksum=b7a2c3e65799a649d29e9927a337f99cca2a5fc46367a0ce101435be74e53b39

_rockname=${pkgname#lua55-}
_rocksrel=1
_pkg() {
	luarocks --lua-version="$1" --tree="${PKGDESTDIR}/usr" \
		make  --deps-mode=none --no-manifest "rockspecs/${_rockname}-${version}-${_rocksrel}.rockspec"
}

do_install() {
	_pkg 5.4
	vlicense LICENSE.md
}

lua51-penlight_package() {
	metapackage=yes
	depends="lua51 lua51-luafilesystem"
	pkg_install() {
		_pkg 5.1
		vlicense LICENSE.md
	}
}

